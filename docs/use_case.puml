@startuml
left to right direction
actor "Пользователь" as user

rectangle "Десктопный помощник" {
  usecase "Выбрать изображение\nперсонажа" as UC1
  usecase "Переместить персонажа\nпо экрану" as UC2
  usecase "Свернуть в трей" as UC3
  usecase "Развернуть из трея" as UC4
  usecase "Создать команду" as UC5
  usecase "Удалить команду" as UC6
  usecase "Выполнить команду" as UC7
  usecase "Подтвердить\nвыключение ПК" as UC8
}

user -- UC1
user -- UC2
user -- UC3
user -- UC4
user -- UC5
user -- UC6
user -- UC7
UC8 .> UC7 : <<extend>>
@enduml